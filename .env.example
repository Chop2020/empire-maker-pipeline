# Copy to .env for local runs. On Replit, put these in Secrets instead.

# Optional: turns on the Claude structure check + source review during ingest
ANTHROPIC_API_KEY=
# INGEST_MODEL=claude-sonnet-5-5
# REVIEW_MODEL=claude-haiku-5-5
# REFINE_MAX_SECTIONS=40          # cost cap per ingest
# REFINE_BELOW_CONFIDENCE=0.7     # only sections less sure than this get sent
# WRITER_MODEL=claude-sonnet-5-5
# PERSONA_MODEL=claude-sonnet-5-5
# WRITER_CONCURRENCY=4
# Optional: show $ estimates before a Writer run (your current per-million-token prices)
# PRICE_IN_PER_MTOK=
# PRICE_OUT_PER_MTOK=

# Images: FLUX.2 [pro] from Black Forest Labs (https://bfl.ai → API keys). Prompts are written by Claude (ANTHROPIC_API_KEY).
BFL_API_KEY=
# IMAGE_MODEL=flux-2-pro            # flux-2-max = highest quality, ~2x price
# IMAGE_DIRECTOR_MODEL=claude-sonnet-5-5
# IMAGE_CONCURRENCY=4
# IMAGE_PROVIDER=mock               # offline placeholders, no key needed

# Postgres (Replit sets this when you add the PostgreSQL tool). Blank = embedded PGlite in ./data
DATABASE_URL=

# local (./data/files) or replit (Replit Object Storage — use this for deployments)
STORAGE=local

# Protect the app with a password (recommended — Replit URLs are public)
APP_PASSWORD=

# Only if Chromium isn't found automatically
# CHROME_PATH=/usr/bin/chromium

# PORT=3000
# DATA_DIR=./data
